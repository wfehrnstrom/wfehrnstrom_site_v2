---

// TODO: not super set on this progress/loading bar naming convention, because although it could be used as a
//  loading bar element in a different context and looks like one, it's just a stylistic motif in the header for now.

import { Image } from 'astro:assets';

import forwardSlantingDivider from '../resources/images/progress-bar.png';
import backSlantingDivider from '../resources/images/mirrored-progress-bar.png'

interface Props {
  slant?: string;
  delay?: string;
  duration?: string;
}

const {slant = "forwards", delay = "0s", duration = "5s"} = Astro.props;


let imageSource, topDividerDisplay, bottomDividerDisplay;

if (slant === "forwards") {
    imageSource = forwardSlantingDivider;
	topDividerDisplay = "block";
	bottomDividerDisplay = "none";
} else {
    imageSource = backSlantingDivider;
	topDividerDisplay = "none";
	bottomDividerDisplay = "block";
}
---
<div class="slanting-divider-wrapper">
	<div class="divider-line"></div>
		<div>
			<Image class="slanted-divider" src={imageSource} alt="Dividing loading bar loading across the page" loading="eager"/>
		</div>
	<div class="divider-line"></div>
</div>

<style lang="scss" define:vars={{ slant, delay, duration, topDividerDisplay, bottomDividerDisplay }}>
	@use '../styles/_mixins.scss' as *;
	
	@use "sass:list";
	@use "sass:math";

	$slanted_polygon_pixel_width: 22px;
	$space_between_polygons: 6px;
	$slant_offset: 33px;
	$divider-line-animation-duration: 2s;
	
	@function ith_offset($step_size, $i, $initial_offset: 0%) {
		@return ($step_size * $i) + $initial_offset; 
	}

	@function slant_offsets($step_size, $initial_offset: 0%, $limit: 100%)  {
		$offsets: [];
		$curr_offset: $initial_offset;
		$i: 0;

		@while ($curr_offset < $limit) {
			$curr_offset: math.min($limit, ith_offset($step_size, $i, $initial_offset));
			$i: $i + 1;
			$offsets: list.append($offsets, $curr_offset);
		}

		@return $offsets;
	}

	@function to_n($n) {
		$l: [];
		@for $i from 0 to $n {
			$l: list.append($l, $i);
		}

		@return $l;
	}

	@function zipped_keyframe($forwards_orientation, $limit_to_width: 100%) {
		$total_width: 755px;
		$offset_amount: math.div(($slanted_polygon_pixel_width + $space_between_polygons), $total_width) * 100%;
		$skew_width: math.div($slant_offset, $total_width) * 100%;
		$slanted_polygon_width: math.div($slanted_polygon_pixel_width, $total_width) * 100%;
		$space_between_polygons: math.div($space_between_polygons, $total_width) * 100%;
		$divider_line_width: $total_width - $slant_offset;
		$lower_x_limit: $limit_to_width - $skew_width;

		@if ($forwards_orientation) {
			$top_row_offsets: slant_offsets($offset_amount, $skew_width, $limit_to_width);
			$bottom_row_offsets: slant_offsets($offset_amount, $limit: $lower_x_limit);
			$indexes: to_n(list.length($top_row_offsets));

			@return list.zip($indexes, $top_row_offsets, $bottom_row_offsets);
		} @else {
			$top_row_offsets: slant_offsets($offset_amount, $limit: $lower_x_limit);
			$bottom_row_offsets: slant_offsets($offset_amount, $skew_width, $limit_to_width);
			$indexes: to_n(list.length($top_row_offsets));

			@return list.zip($indexes, $top_row_offsets, $bottom_row_offsets);
		}
	}

	@mixin polygon_divider_keyframes($total_width: 100%) {
		@keyframes forwards {
			$offsets: zipped_keyframe(true, $total_width);

			@each $index, $top_x_coord, $bottom_x_coord in $offsets {
				$p: $index * math.div(100%, list.length($offsets));
				// needed because CSS keyframes in "animation-direction: forwards" will automatically snap to the full 
				// image if 100% keyframe state isn't the last.
				@if ($index == list.length($offsets) - 1) {
					$p: 100%;
				}
				#{$p} {
					clip-path: polygon(0% 0%, $top_x_coord 0%, $bottom_x_coord 100%, 0% 100%);
				} 
			}
		}

		@keyframes backwards {
			$offsets: zipped_keyframe(false, $total_width);

			@each $index, $top_x_coord, $bottom_x_coord in $offsets {
				$p: $index * math.div(100%, list.length($offsets));
				@if ($index == list.length($offsets) - 1) {
					$p: 100%;
				}
				#{$p} {
					clip-path: polygon(0% 0%, $top_x_coord 0%, $bottom_x_coord 100%, 0% 100%);
				} 
			}
		}
	}

	@include for-desktop-viewport {
		$total_slanted_polygons_width: 755px;

		.divider-line {
			position: relative;
			left: $slant_offset;
			width: 100%;
			height: 1px;
			background-color: black;
			animation: 2s ease-out 1 normal extend-line;
		}

		.slanting-divider-wrapper > div:first-of-type {
			display: var(--topDividerDisplay);
		}

		.slanting-divider-wrapper > div:last-of-type {
			display: var(--bottomDividerDisplay);
		}

		.slanted-divider {
			margin: 0;
			animation-fill-mode: forwards;
			animation-direction: normal;
			animation-duration: var(--duration);
			animation-delay: var(--delay) + $divider-line-animation-duration;
			animation-timing-function: steps(1, start);
			animation-name: var(--slant);
		}

		@include polygon_divider_keyframes;
	}

	@include for-custom-horizontal-breakpoints(1100px, $desktop-breakpoint) {
		$total_slanted_polygons_width: math.div(615px, 755px) * 100%;

		.divider-line {
			position: relative;
			left: $slant_offset;
			width: 100%;
			height: 1px;
			background-color: black;
			animation: $divider-line-animation-duration ease-out 1 normal extend-line;
		}

		.slanting-divider-wrapper > div:first-of-type {
			display: var(--topDividerDisplay);
		}

		.slanting-divider-wrapper > div:last-of-type {
			display: var(--bottomDividerDisplay);
		}

		.slanted-divider {
			margin: 0;
			animation-fill-mode: forwards;
			animation-direction: normal;
			animation-duration: var(--duration);
			animation-delay: var(--delay) + $divider-line-animation-duration;
			animation-timing-function: steps(1, start);
			animation-name: var(--slant);
		}

		@include polygon_divider_keyframes($total_slanted_polygons_width);
	}

	@include for-custom-horizontal-breakpoints(860px, 1100px) {
		$total_slanted_polygons_width: math.div(475px, 755px) * 100%;
		
		.divider-line {
			position: relative;
			left: $slant_offset;
			width: 100%;
			height: 1px;
			background-color: black;
			animation: 2s ease-out 1 normal extend-line;
		}

		.slanting-divider-wrapper > div:first-of-type {
			display: var(--topDividerDisplay);
		}

		.slanting-divider-wrapper > div:last-of-type {
			display: var(--bottomDividerDisplay);
		}

		.slanted-divider {
			margin: 0;
			animation-fill-mode: forwards;
			animation-direction: normal;
			animation-duration: var(--duration);
			animation-delay: var(--delay) + $divider-line-animation-duration;
			animation-timing-function: steps(1, start);
			animation-name: var(--slant);
		}

		@include polygon_divider_keyframes($total_slanted_polygons_width);
	}

	@include for-custom-horizontal-breakpoints(0px, 860px) {
		.slanting-divider-wrapper {
			display: none;
		}
	}

	@keyframes extend-line {
		from {
			width: 0;
		}
		to {
			width: 100%;
		}
	}
</style>