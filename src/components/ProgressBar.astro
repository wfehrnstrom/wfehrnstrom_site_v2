---

// TODO: not super set on this progress/loading bar naming convention, because although it could be used as a
//  loading bar element in a different context and looks like one, it's just a stylistic motif in the header for now.

import { Image } from 'astro:assets';

import progressBar from '../resources/images/progress-bar.png';
import reverseProgressBar from '../resources/images/mirrored-progress-bar.png'

interface Props {
  reversed?: boolean;
}

const {reversed = false} = Astro.props;


let className, imageSource;

if (reversed) {
    className = "reverse-progress-bar";
    imageSource = reverseProgressBar;
} else {
    className = "progress-bar";
    imageSource = progressBar;
}
---

<div>
    <Image class={className} src={imageSource} alt="Dividing loading bar loading across the page" loading="eager"/>
</div>

<style>
    .progress-bar {
		margin: 0;
		animation-name: loading-progress-bar;
		animation-timing-function: steps(1, start);
		animation-duration: 5s;
		animation-delay: 0.5s;
		animation-fill-mode: backwards;
		animation-direction: normal;
	}

	.reverse-progress-bar {
		margin: 0;
		animation-name: reverse-loading-progress-bar;
		animation-timing-function: steps(1, start);
		animation-duration: 5s;
		animation-delay: 6s;
		animation-fill-mode: backwards;
		animation-direction: normal;
	}

    @keyframes loading-progress-bar {
		0% {
			clip-path: polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%);
		}

		4% {
			clip-path: polygon(2.06rem 0%, 3.46rem 0%, 1.73rem 100%, 0% 100%);
		}

		8% {
			clip-path: polygon(2.06rem 0%, 5.19rem 0%, 3.46rem 100%, 0% 100%);
		}

		12% {
			clip-path: polygon(2.06rem 0%, 7.25rem 0%, 5.19rem 100%, 0% 100%);
		}

		16% {
			clip-path: polygon(2.06rem 0%, 8.98rem 0%, 6.92rem 100%, 0% 100%);
		}

		20% {
			clip-path: polygon(2.06rem 0%, 10.71rem 0%, 8.65rem 100%, 0% 100%);
		}

		24% {
			clip-path: polygon(2.06rem 0%, 12.44rem 0%, 10.38rem 100%, 0% 100%);
		}

		28% {
			clip-path: polygon(2.06rem 0%, 14.17rem 0%, 12.11rem 100%, 0% 100%);
		}

		32% {
			clip-path: polygon(2.06rem 0%, 15.9rem 0%, 13.84rem 100%, 0% 100%);
		}

		36% {
			clip-path: polygon(2.06rem 0%, 17.63rem 0%, 15.57rem 100%, 0% 100%);
		}

		40% {
			clip-path: polygon(2.06rem 0%, 19.36rem 0%, 17.3rem 100%, 0% 100%);
		}

		44% {
			clip-path: polygon(2.06rem 0%, 21.09rem 0%, 19.03rem 100%, 0% 100%);
		}

		48% {
			clip-path: polygon(2.06rem 0%, 22.82rem 0%, 20.76rem 100%, 0% 100%);
		}

		52% {
			clip-path: polygon(2.06rem 0%, 24.55rem 0%, 22.49rem 100%, 0% 100%);
		}

		56% {
			clip-path: polygon(2.06rem 0%, 26.28rem 0%, 24.22rem 100%, 0% 100%);
		}

		60% {
			clip-path: polygon(2.06rem 0%, 28.01rem 0%, 25.95rem 100%, 0% 100%);
		}

		64% {
			clip-path: polygon(2.06rem 0%, 29.74rem 0%, 27.68rem 100%, 0% 100%);
		}

		68% {
			clip-path: polygon(2.06rem 0%, 31.47rem 0%, 29.41rem 100%, 0% 100%);
		}

		72% {
