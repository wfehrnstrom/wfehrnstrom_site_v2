---
import { Image } from 'astro:assets';

import myPicture from '../resources/images/me-cropped.jpg';
---
<div class="my-image-container">
    <Image class="my-image" src={myPicture} alt="me in Central Park with the New York Skyline in the background" object-fit="cover" loading="eager"/>
</div>


<style>
    .my-image-container {
		position: fixed;
        top: 30vh;
        left: 65vw;
		flex: 1 3 26rem;
		padding: 0;
		width: 26rem;
		height: 26rem;
        z-index: 10;
	}

	.my-image {
		position: absolute;
		left: 0;
		top: 0;
		display: block;
		margin-left: 0;
		width: 100%;
		object-fit: contain;
	}
</style>