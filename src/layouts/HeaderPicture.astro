---
import { Image } from 'astro:assets';

import myPicture from '../resources/images/me-cropped.jpg';
---

<div class="my-image-container">
    <Image class="my-image" src={myPicture} alt="me in Central Park with the New York Skyline in the background" object-fit="cover" loading="eager"/>
</div>


<style lang="scss">
	@use '../styles/_mixins.scss' as *;

	.my-image-container {
		position: fixed;
        top: 30vh;
		padding: 0;
		width: 26rem;
		height: 26rem;
        z-index: 10;
	}

	@include for-desktop-viewport {
		.my-image-container {
        	left: 65vw;
		}
	}

	@include for-tablet-viewport {
		.my-image-container {
			left: 60vw;
			width: 24rem;
			height: 24rem;
		}
	}

	.my-image {
		position: absolute;
		left: 0;
		top: 0;
		display: block;
		margin-left: 0;
		width: 100%;
		object-fit: contain;
	}
</style>