---
import { Image } from 'astro:assets';

import myPicture from '../resources/images/me-cropped.jpg';
---

<div class="my-image-container">
    <Image class="my-image" src={myPicture} alt="me in Central Park with the New York Skyline in the background" object-fit="cover" loading="eager"/>
</div>


<style lang="scss">
	@use '../styles/_mixins.scss' as *;

	@use "sass:math";

	.my-image-container {
		@include centered-vertically-in-parent(fixed);

		width: 26rem;
		height: 26rem;
		left: 65vw;
		padding: 0;
        z-index: 3;
	}

	.my-image {
		position: absolute;
		left: 0;
		top: 0;
		display: block;
		margin-left: 0;
		width: 100%;
		object-fit: contain;
	}

	@include for-custom-horizontal-breakpoints(860px, 1100px) {
		.my-image-container {
			@include centered-vertically-in-parent(fixed);

			left: 60vw;
			width: 24rem;
			height: 24rem;
		}
	}

	@include for-custom-horizontal-breakpoints(0px, 860px) {
		.my-image-container {
			position: absolute;
			margin: 1rem;
			left: 0;
			right: 0;
			top: 0;
			width: auto;
			height: auto;
		}

		.my-image-container > .my-image {
			height: auto;
		}
	}
</style>