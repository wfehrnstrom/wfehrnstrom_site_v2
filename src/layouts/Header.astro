		}

		80% {
			clip-path: polygon(2.06rem 0%, 36.66rem 0%, 34.6rem 100%, 0% 100%);
		}

		84% {
			clip-path: polygon(2.06rem 0%, 38.39rem 0%, 36.33rem 100%, 0% 100%);
		}

		88% {
			clip-path: polygon(2.06rem 0%, 40.12rem 0%, 38.06rem 100%, 0% 100%);
		}

		92% {
			clip-path: polygon(2.06rem 0%, 41.85rem 0%, 39.79rem 100%, 0% 100%);
		}

		96% {
			clip-path: polygon(2.06rem 0%, 43.58rem 0%, 41.52rem 100%, 0% 100%);
		}

		100% {
			clip-path: polygon(2.06rem 0%, 45.31rem 0%, 43.25rem 100%, 0% 100%);
		}
	}

	@keyframes reverse-loading-progress-bar {
		0% {
