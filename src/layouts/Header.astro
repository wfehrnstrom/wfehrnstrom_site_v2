---
import { Image } from 'astro:assets';

import myPicture from '../resources/images/me-cropped.jpg';
import githubLogo from '../../public/logos/github-mark.png';
import linkedinLogo from '../../public/logos/linkedinlogo-bw.png';
import spotifyLogo from '../../public/logos/spotify-logo-bw.png';

import progressBar from '../resources/images/progress-bar.png';
import reverseProgressBar from '../resources/images/mirrored-progress-bar.png'
---

<div class="header-page page">
    <div class="centered header-wrapper">
        <div class="header-menu-container">
            <h1 class="page-title title-name">Will Fehrnstrom</h1>
			<div><Image class="progress-bar" src={progressBar} alt="Loading bar" loading="eager"/></div>
            <ul class="header-navigation-menu">
                <li><a href="#about-me">About Me</a></li>
                <li><a href="https://drive.google.com/file/d/1gpMcLU_fAqnOaEJdMx6SarLoOVDa6Khh/view?usp=sharing">Resume</a></li>
            </ul>
			<div><Image class="reverse-progress-bar" src={reverseProgressBar} alt="Loading bar loading in reverse direction" loading="eager"/></div>
            <div class="external-links">
                <a href="https://github.com/wfehrnstrom"><Image src={githubLogo} alt="Github Octocat" loading="eager"/></a>
                <a href="https://www.linkedin.com/in/william-f-aba4a5119/"><Image src={linkedinLogo} 			alt="LinkedIn Symbol" loading="eager"/></a>
                <a href="https://open.spotify.com/playlist/4vkeZxk3irDgA88vB26ljg?si=db99d76f4f3c4093"><Image src={spotifyLogo} alt="Spotify Symbol" loading="eager"/></a>
            </div>
        </div>
    </div>		
</div>

<style>
	.header-page {
		position: sticky;
		top: 0;
		height: 100vh;
        z-index: 0;
        background-color: white;
	}

	.header-wrapper {
		width: 90vw;
		display: flex;
	}

	.header-menu-container {
		flex: 3 1 auto;
		margin-right: 2rem;
	}

	.title-name {
        z-index: 2;
		margin-bottom: 0;
	}

	.header-navigation-menu {
		display: inline-flex;
		list-style-type: none;
		margin: 1.89rem 0 1.89rem 1.26rem;
		padding: 0;
	}

	.header-navigation-menu li {
		padding: 0;
		margin: 0 7.13rem 0 0;
		width: 5rem;
	}

	.header-navigation-menu li a {
		margin: 0px; 
		display: block; 
		width: 100%; 
		height: 100%;
	}

	.header-navigation-menu > li:first-of-type {
		padding-left: 0;
	}

	.header-navigation-menu a:link, .header-navigation-menu a:visited {
		color: black;
		text-decoration: none;
	}

	.header-navigation-menu a:hover {
		color: rgb(85, 85, 85);
	}

	.progress-bar {
		margin: 0;
		animation-name: loading-progress-bar;
		animation-timing-function: steps(1, start);
		animation-duration: 5s;
		animation-delay: 0.5s;
		animation-fill-mode: backwards;
		animation-direction: normal;
	}

	.reverse-progress-bar {
		margin: 0;
		animation-name: reverse-loading-progress-bar;
		animation-timing-function: steps(1, start);
		animation-duration: 5s;
		animation-delay: 6s;
		animation-fill-mode: backwards;
		animation-direction: normal;
	}

	.external-links {
		display: flex;
		margin: 3rem 0 0 1.26rem;
	}

	.external-links a {
		display: block;
		width: 2.13rem;
		margin: 0;
		margin-right: 10rem;
	}

	.external-links a:hover {
		display: block;
		width: 2.13rem;
		margin: 0;
		margin-right: 10rem;
		opacity: 0.75;
	}

	.external-links img {
		object-fit: contain;
		width: 100%;
	}

	.external-links img:last-of-type {
		margin-right: 0;
	}

	.my-image-container {
		position: relative;
		flex: 1 3 26rem;
		margin: 0;
		padding: 0;
		width: 26rem;
		height: 26rem;
	}

	.my-image {
		position: absolute;
		left: 0;
		top: 0;
		display: block;
		margin-left: 0;
		width: 100%;
		object-fit: contain;
	}

	@keyframes loading-progress-bar {
		0% {
			clip-path: polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%);
		}

		4% {
			clip-path: polygon(2.06rem 0%, 3.46rem 0%, 1.73rem 100%, 0% 100%);
		}

		8% {
			clip-path: polygon(2.06rem 0%, 5.19rem 0%, 3.46rem 100%, 0% 100%);
		}

		12% {
			clip-path: polygon(2.06rem 0%, 7.25rem 0%, 5.19rem 100%, 0% 100%);
		}

		16% {
			clip-path: polygon(2.06rem 0%, 8.98rem 0%, 6.92rem 100%, 0% 100%);
		}

		20% {
			clip-path: polygon(2.06rem 0%, 10.71rem 0%, 8.65rem 100%, 0% 100%);
		}

		24% {
			clip-path: polygon(2.06rem 0%, 12.44rem 0%, 10.38rem 100%, 0% 100%);
		}

		28% {
			clip-path: polygon(2.06rem 0%, 14.17rem 0%, 12.11rem 100%, 0% 100%);
		}

		32% {
			clip-path: polygon(2.06rem 0%, 15.9rem 0%, 13.84rem 100%, 0% 100%);
		}

		36% {
			clip-path: polygon(2.06rem 0%, 17.63rem 0%, 15.57rem 100%, 0% 100%);
		}

		40% {
			clip-path: polygon(2.06rem 0%, 19.36rem 0%, 17.3rem 100%, 0% 100%);
		}

		44% {
			clip-path: polygon(2.06rem 0%, 21.09rem 0%, 19.03rem 100%, 0% 100%);
		}

		48% {
			clip-path: polygon(2.06rem 0%, 22.82rem 0%, 20.76rem 100%, 0% 100%);
		}

