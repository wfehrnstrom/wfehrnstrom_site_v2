		}

		16% {
			clip-path: polygon(0% 0%, 6.92rem 0%, 8.65rem 100%, 0% 100%);
		}

		20% {
			clip-path: polygon(0% 0%, 8.65rem 0%, 10.38rem 100%, 0% 100%);
		}

		24% {
			clip-path: polygon(0% 0%, 10.38rem 0%, 12.11rem 100%, 0% 100%);
		}

		28% {
			clip-path: polygon(0% 0%, 12.11rem 0%, 13.84rem 100%, 0% 100%);
		}

		32% {
			clip-path: polygon(0% 0%, 13.84rem 0%, 15.57rem 100%, 0% 100%);
		}

		36% {
			clip-path: polygon(0% 0%, 15.57rem 0%, 17.3rem 100%, 0% 100%);
		}

		40% {
			clip-path: polygon(0% 0%, 17.3rem 0%, 19.03rem 100%, 0% 100%);
		}

		44% {
			clip-path: polygon(0% 0%, 19.03rem 0%, 20.76rem 100%, 0% 100%);
		}

		48% {
			clip-path: polygon(0% 0%, 20.76rem 0%, 22.49rem 100%, 0% 100%);
		}

		52% {
			clip-path: polygon(0% 0%, 22.49rem 0%, 24.22rem 100%, 0% 100%);
		}

		56% {
			clip-path: polygon(0% 0%, 24.22rem 0%, 25.95rem 100%, 0% 100%);
		}

		60% {
			clip-path: polygon(0% 0%, 25.95rem 0%, 27.68rem 100%, 0% 100%);
		}

		64% {
			clip-path: polygon(0% 0%, 27.68rem 0%, 29.41rem 100%, 0% 100%);
		}

		68% {
			clip-path: polygon(0% 0%, 29.41rem 0%, 31.14rem 100%, 0% 100%);
		}

		72% {
			clip-path: polygon(0% 0%, 31.14rem 0%, 32.87rem 100%, 0% 100%);
		}

		76% {
			clip-path: polygon(0% 0%, 32.87rem 0%, 34.6rem 100%, 0% 100%);
		}

		80% {
			clip-path: polygon(0% 0%, 34.6rem 0%, 36.33rem 100%, 0% 100%);
		}

		84% {
			clip-path: polygon(0% 0%, 36.33rem 0%, 38.06rem 100%, 0% 100%);
		}

		88% {
			clip-path: polygon(0% 0%, 38.06rem 0%, 39.79rem 100%, 0% 100%);
		}

		92% {
			clip-path: polygon(0% 0%, 39.79rem 0%, 41.52rem 100%, 0% 100%);
		}

		96% {
			clip-path: polygon(0% 0%, 41.52rem 0%, 43.25rem 100%, 0% 100%);
		}

		100% {
			clip-path: polygon(0% 0%, 43.25rem 0%, 44.98rem 100%, 0% 100%);
		}
	}
</style>