---
import githubLogo from '../../public/logos/github-mark.png';
import linkedinLogo from '../../public/logos/linkedinlogo-bw.png';
import spotifyLogo from '../../public/logos/spotify-logo-bw.png';

import SlantedLoadingDivider from '../components/SlantedLoadingDivider.astro';
import SymbolLinkTray from '../components/SymbolLinkTray.astro';

let externalLinkTrayItems = [
	{
		href: "https://github.com/wfehrnstrom",
		metadata: githubLogo,
		alt: "Github Octocat"
	},
	{
		href: "https://www.linkedin.com/in/william-f-aba4a5119/",
		metadata: linkedinLogo,
		alt: "LinkedIn Logo"
	},
	{
		href: "https://open.spotify.com/playlist/4vkeZxk3irDgA88vB26ljg?si=db99d76f4f3c4093",
		metadata: spotifyLogo,
		alt: "Spotify Logo"
	}
];
---

<div class="header-page page">
    <div class="header-wrapper">
        <div class="header-menu-container">
            <h1 class="page-title title-name">Will Fehrnstrom</h1>
			<SlantedLoadingDivider slant="backwards"/>
            <ul class="header-navigation-menu">
                <li><a href="#about-me">About Me</a></li>
                <li><a href="https://drive.google.com/file/d/1gpMcLU_fAqnOaEJdMx6SarLoOVDa6Khh/view?usp=sharing">Resume</a></li>
            </ul>
			<SlantedLoadingDivider slant="forwards"/>
            <SymbolLinkTray id="inlined-external-links" links={externalLinkTrayItems}/>
        </div>
    </div>
	<SymbolLinkTray id="separated-external-links" links={externalLinkTrayItems}/>
</div>

<style lang="scss">
	@use '../styles/_mixins.scss' as *;

	@import url('../styles/main.scss');

	.header-page {
		position: sticky;
		top: 0;
		height: 100vh;
        z-index: 0;
        background-color: white;
	}

	.header-wrapper {
		display: flex;
		padding-right: 5vw;
	}

	.header-menu-container {
		flex: 3 1 auto;
		margin-right: 2rem;
	}

	.title-name {
        z-index: 2;
		margin-bottom: 0;
	}

	.header-navigation-menu {
		display: inline-flex;
		list-style-type: none;
		padding: 0;
	}

	.header-navigation-menu li {
		padding: 0;
		width: 5rem;
	}

	.header-navigation-menu a {
		margin: 0; 
		display: block; 
		width: 100%; 
		height: 100%;
	}

	.header-navigation-menu > li:first-of-type {
		padding-left: 0;
	}

	.header-navigation-menu a:link, .header-navigation-menu a:visited {
		color: black;
		text-decoration: none;
	}

	.header-navigation-menu a:hover {
		color: rgb(85 85 85);
	}

	@media screen and (min-width: 860px) {
		.header-wrapper {
			@include centered-vertically-in-parent;

			padding-left: 5vw;
		}

		.header-navigation-menu {
			margin: 1.89rem 0 1.89rem 2.5rem;
		}

		.header-navigation-menu li {
			margin: 0 7.13rem 0 0;
		}
	}

	@include for-custom-horizontal-breakpoints(0px, 860px)  {
		.header-page {
			position: static;
			background-color: rgba(0, 0, 0, 0);
			height: 113vw;
		}

		.header-wrapper {
			position: absolute;
			top: 0;
			right: 0;
			display: flex;
			z-index: 4;
			padding-right: 0;
		}

		.header-menu-container {
			position: relative;
			flex-direction: column;
		}

		.header-navigation-menu {
			flex-direction: column;
			margin-top: 5rem;
			text-align: right;
		}

		.header-navigation-menu li:first-of-type {
			margin-top: 0;
		}

		.header-navigation-menu li {
			margin-top: 0.75rem;
		}

		.title-name {
			position: absolute;
			top: 1.25rem;
			right: 0;

			width: 15.28rem;
			margin-top: 0;

			font-size: 2rem;
		}
	}

	@include for-desktop-viewport {
		.header-wrapper {
			width: 60vw;
		}
	}
</style>